# Copy this file to .env.local (which stays out of Git) and fill it in.
# Next reads this file by itself in `npm run dev` and `npm run build`.
#
# In production, the same names go in the Vercel dashboard
# (Settings → Environment Variables).

# Mercado Pago token. It is a SECRET: never use the NEXT_PUBLIC_ prefix on it,
# because the token would end up in the browser of whoever visits the site.
MP_ACCESS_TOKEN=TEST-cole-aqui-o-token-de-teste

# Public address of the site, with https. Used in the sponsorship plans and
# in the sharing links.
SITE_URL=https://seu-site.vercel.app

# Pix key that receives the donations. It lives only here and in the Vercel
# dashboard, never in the code. Without it, the Pix tab shows "Pix ainda não configurado".
PIX_KEY=

# Sanity (optional; without them, the site uses the sample animals).
# SANITY_PROJECT_ID=
# SANITY_DATASET=production
